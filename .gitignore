# Build caches and superseded repair snapshots are local only.
/build-support/
/previous-*/
# Release ZIPs contain the extracted application/runtime files.
/*/Netory-Windows-x64/*
!/*/Netory-Windows-x64/manifest.json
!/*/Netory-Windows-x64/DEPENDENCIES.txt
!/*/Netory-Windows-x64/version.json
__pycache__/
*.pyc

# Versioned platform releases keep extracted Windows payloads local.
/*/Windows/Netory-Windows-x64/*
!/*/Windows/Netory-Windows-x64/manifest.json
!/*/Windows/Netory-Windows-x64/DEPENDENCIES.txt
!/*/Windows/Netory-Windows-x64/version.json

# Private installer refresh workspaces and retained local release backups.
/.refresh-*/
/.previous-*/
